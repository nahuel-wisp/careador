{
  "name": "careador",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev -w @careador/server",
    "dev:web": "npm run dev -w @careador/web",
    "build": "npm run build -w @careador/web && npm run build -w @careador/server",
    "start": "npm run start -w @careador/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
