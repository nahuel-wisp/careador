# Puerto HTTP del servidor
PORT=8080
# Carpeta donde se guarda la base SQLite
DATA_DIR=./data
# Clave para cifrar credenciales de equipos (32+ caracteres aleatorios). NO commitear.
CAREADOR_SECRET=cambiar-por-una-clave-larga-y-aleatoria
# true si corre detrás de un proxy inverso (Traefik) que manda X-Forwarded-*
TRUST_PROXY=false
# Nombre del entorno (produccion | pruebas). En pruebas la app muestra una franja de aviso.
CAREADOR_ENTORNO=produccion
# true = nunca escribir en los equipos reales (entorno de pruebas)
DEVICES_READ_ONLY=false
# true = habilita el lector simulado
SIMULATOR_ENABLED=false
