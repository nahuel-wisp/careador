# /srv/careador-arsa-test/.env — PRUEBAS (arsa-test.nasistemas.com.ar)
CAREADOR_IMAGE=careador:latest
CAREADOR_PORT=8180
CAREADOR_ENTORNO=pruebas
CAREADOR_EMPRESA=American Rider
# Clave distinta a la de producción
CAREADOR_SECRET=generar-con-openssl-rand-base64-48
# Equipos reales en sólo lectura: pruebas nunca escribe en los lectores del cliente
DEVICES_READ_ONLY=true
SIMULATOR_ENABLED=true
