[Unit]
Description=Careador (personal, horarios y asistencia)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=careador
Group=careador
WorkingDirectory=/opt/careador/apps/server
EnvironmentFile=/opt/careador/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5

# Endurecimiento
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/careador

[Install]
WantedBy=multi-user.target
